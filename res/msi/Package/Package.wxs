<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
	xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<?include Includes.wxi?>

	<!-- BCS Beam fix (2026-08-25): ProductDisplayName (spaced, e.g. "BCS Beam")
	     is the user-visible wizard title / ARP name; $(var.Product) stays the
	     space-free technical identifier used for the exe filename, registry
	     keys, and service name elsewhere. See Includes.wxi / preprocess.py. -->
	<Package Name="$(var.ProductDisplayName)" Version="$(var.Version)" Manufacturer="$(var.Manufacturer)" Language="!(loc.ProductLanguage)" UpgradeCode="$(var.UpgradeCode)" Scope="perMachine">

		<SummaryInformation Keywords="Installer" Description="$(var.Description)" Codepage="!(loc.SummaryCodepage)" />

		<!--<PropertyRef Id="UpgradesFile" />-->

		<PropertyRef Id="AddRemovePropertiesFile" />

		<Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" CompressionLevel="high" />
		<Icon Id="AppIcon" SourceFile="Resources\icon.ico" />

		<!-- User Interface -->
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<ui:WixUI Id="UI_MyInstallDialog" InstallDirectory="INSTALLFOLDER_INNER" />
		<UIRef Id="WixUI_ErrorProgressText" />

		<InstallUISequence>
			<Show Dialog="UI_AnotherAppDialog" Before="WelcomeDlg" Condition="Not installed AND APP_WINDOWS_INSTALLER=&quot;#0&quot;"/>
			<!-- BCS Beam addition (2026-08-27): when an older MSI version is
			     installed, MajorUpgrade used to remove it silently. Now the
			     user is asked to consent first; declining aborts the install
			     and leaves the old version untouched. WIX_UPGRADE_DETECTED is
			     set by MajorUpgrade's FindRelatedProducts, which runs earlier
			     in the UI sequence than any dialog. -->
			<Show Dialog="UI_OldVersionDialog" Before="WelcomeDlg" Condition="Not installed AND WIX_UPGRADE_DETECTED"/>
		</InstallUISequence>

		<InstallExecuteSequence>
			<RemoveExistingProducts After="InstallInitialize" />
			<InstallExecute After="RemoveExistingProducts" />

			<!--Only do InstallValidate if is not Uninstall-->
			<!--<InstallValidate Condition="NOT (Installed AND REMOVE AND NOT UPGRADINGPRODUCTCODE )" />-->
			<!--Only do InstallValidate if is Install-->
			<InstallValidate Condition="NOT Installed" />

		</InstallExecuteSequence>

		<!-- BCS Beam fix (2026-08-27): replaced <MajorUpgrade .../> with manual
		     Upgrade rows. MajorUpgrade stamped this package's own language into
		     the Upgrade table's Language filter (verified in the built MSI:
		     Language=2052 in the zh-cn package), so a zh-CN installer could not
		     detect an installed en-US product and vice versa — cross-language
		     upgrades silently fell through to a side-by-side dual install
		     (reproduced on a real machine: en-US 1.3.9.x + zh-CN 1.3.9.y both
		     registered under the same UpgradeCode). UpgradeVersion without a
		     Language attribute writes an empty Language column = match ANY
		     language. Semantics otherwise identical to the old
		     MajorUpgrade AllowSameVersionUpgrades="yes" +
		     Schedule="afterInstallInitialize" (IncludeMaximum=yes covers the
		     same-version case; RemoveExistingProducts scheduled above).
		     Version3 (first three fields) keeps the rows within MSI's
		     documented version-field range; comparison ignores the 4th field
		     anyway. -->
		<Upgrade Id="$(var.UpgradeCode)">
			<UpgradeVersion Maximum="$(var.Version3)" IncludeMaximum="yes" MigrateFeatures="yes" Property="WIX_UPGRADE_DETECTED" />
			<UpgradeVersion Minimum="$(var.Version3)" IncludeMinimum="no" OnlyDetect="yes" Property="WIX_DOWNGRADE_DETECTED" />
		</Upgrade>
		<Launch Condition="NOT WIX_DOWNGRADE_DETECTED" Message="!(loc.DowngradeError)" />

		<Feature Id="App" Level="1" AllowAdvertise="no" Display="expand" Title="!(loc.F_App)" Description="!(loc.F_App_Desc)" AllowAbsent="no">
			<ComponentGroupRef Id="Components" />

			<ComponentRef Id="Product.Registry.InstallFolder" />
			<ComponentRef Id="Product.Registry.DefaultIcon" />
			<ComponentRef Id="Product.Registry.CommandPlay" />
			<ComponentRef Id="Product.Registry.URLProtocol" />
			<ComponentRef Id="Product.Registry.Command" />
			<ComponentRef Id="Product.Registry.UninstallApp" />
			<ComponentRef Id="App.StartMenu" />
			<ComponentRef Id="Product.Registry.PersistedStartMenuShortcutProperties1" />
			<ComponentRef Id="Product.Registry.PersistedStartMenuShortcutProperties0" />
			<ComponentRef Id="Product.Registry.PersistedDesktopShortcutProperties1" />
			<ComponentRef Id="Product.Registry.PersistedDesktopShortcutProperties0" />
			<ComponentRef Id="Product.Registry.PersistedPrinterProperties1" />
			<ComponentRef Id="Product.Registry.PersistedPrinterProperties0" />
		</Feature>

		<!--https://wixtoolset.org/docs/tools/wixext/wixui/#customizing-a-dialog-set-->
		<!--$CustomBitmapsStart$-->
		<!--$CustomBitmapsEnd$-->
	</Package>
</Wix>
